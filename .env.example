# Token du bot Discord (Developer Portal > Bot > Token)
DISCORD_TOKEN=

# Préfixe des commandes (optionnel, "!" par défaut)
COMMAND_PREFIX=!

# URL du panel Pterodactyl, ex: http://192.168.1.50:80
PTERODACTYL_URL=

# Clé API client Pterodactyl (commence par ptlc_)
PTERODACTYL_API_KEY=

# IPs publiques des serveurs, séparées par des virgules : Nom=ip:port
# Ex: Survival=192.168.1.50:25565,Creative=192.168.1.50:25566
SERVER_IPS=
